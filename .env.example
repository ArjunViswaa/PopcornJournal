# Copy to .env and fill in. .env is git-ignored.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=popcorn
DB_USER=popcorn
DB_PASSWORD=change-me
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5180,http://127.0.0.1:5180
# Only needed by scripts that create/reset the database on a native PostgreSQL install
PG_SUPERUSER_PASSWORD=change-me
# Optional poster lookup on Wikipedia (sends titles to the Wikipedia API)
POSTERS_ENABLED=false
